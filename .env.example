# ==============================================================================
# SERVERLESS POSTGRESQL DATABASE (NEON / SUPABASE)
# ==============================================================================

# 1. POOLED CONNECTION STRING (Used by Vercel Serverless Functions to prevent connection exhaustion)
# For Neon: postgresql://[user]:[password]@[endpoint]-pooler.[region].neon.tech/[dbname]?sslmode=require&pgbouncer=true
# For Supabase: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# 2. DIRECT CONNECTION STRING (Used by Prisma CLI for schema migrations & db push)
# For Neon: postgresql://[user]:[password]@[endpoint].[region].neon.tech/[dbname]?sslmode=require
# For Supabase: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# NextAuth / JWT Secret
NEXTAUTH_SECRET="your-super-secret-jwt-key-change-in-production"
NEXTAUTH_URL="https://your-master-crm.vercel.app"

# Superadmin Credentials
SUPERADMIN_EMAIL="tuheenbd@gmail.com"

# External Integrations (Optional)
RESEND_API_KEY=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""

